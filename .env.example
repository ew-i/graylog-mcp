# Required Graylog connection settings
GRAYLOG_BASE_URL=https://graylog.example.com
GRAYLOG_API_TOKEN=replace-with-your-graylog-api-token

# TLS and HTTP settings
GRAYLOG_VERIFY_TLS=true
GRAYLOG_ALLOW_INSECURE_HTTP=false
GRAYLOG_TIMEOUT_SECONDS=30

# MCP logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL
MCP_LOG_LEVEL=INFO

# MCP transport: stdio or streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_STREAMABLE_HTTP_PATH=/mcp

# Streamable HTTP DNS-rebinding protection
MCP_ENABLE_DNS_REBINDING_PROTECTION=false
# Comma-separated Host and Origin values, used when protection is enabled
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=

# Optional comma-separated application-specific fields to redact
MCP_REDACT_FIELDS=
