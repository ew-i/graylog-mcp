# Required Graylog connection settings
GRAYLOG_BASE_URL=https://graylog.example.com
GRAYLOG_API_TOKEN=replace-with-your-graylog-api-token

# TLS and HTTP settings
GRAYLOG_VERIFY_TLS=true
GRAYLOG_ALLOW_INSECURE_HTTP=false
GRAYLOG_TIMEOUT_SECONDS=30

# MCP server logging: DEBUG, INFO, WARNING, ERROR, or CRITICAL
GRAYLOG_LOG_LEVEL=INFO

# Optional comma-separated application-specific fields to redact
GRAYLOG_REDACT_FIELDS=
